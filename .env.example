# Copy to .env and fill in. Only needed to re-run the enrichment locally;
# the deployed site runs no Python and needs no key at all.

# Meta Model API (Muse). Generate at dev.meta.ai.
#   python3 -m pipeline.enrich --provider meta --model muse-spark-1.3
MODEL_API_KEY=

# Alternative provider.
#   python3 -m pipeline.enrich --provider anthropic
ANTHROPIC_API_KEY=

# Optional: raises the GitHub Advisories rate limit from 60/hr to 5,000/hr.
GITHUB_TOKEN=
